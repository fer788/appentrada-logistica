{
  "name": "logistica-calendario",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "mysql:start": "node scripts/start-mysql.js",
    "db:create": "node server/ensure-database.js",
    "setup": "npm run mysql:start && npm run db:create",
    "dev:full": "npm run setup && npm run dev",
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "sync": "node scripts/git-sync.js",
    "sync:auto": "node scripts/git-sync.js --auto",
    "sync:patch": "node scripts/git-sync.js --bump=patch --auto",
    "autosync": "node scripts/git-autosync-daemon.js",
    "autosync:patch": "node scripts/git-autosync-daemon.js --bump=patch",
    "startup:install": "powershell -ExecutionPolicy Bypass -File scripts/install-startup.ps1",
    "lan:firewall": "powershell -ExecutionPolicy Bypass -File scripts/open-lan-firewall.ps1",
    "stack:ensure": "powershell -ExecutionPolicy Bypass -File scripts/ensure-stack.ps1",
    "stack:autostart:install": "powershell -ExecutionPolicy Bypass -File scripts/install-stack-autostart.ps1",
    "docs:pdf": "powershell -ExecutionPolicy Bypass -File scripts/generate-infra-pdf.ps1"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "mysql2": "^3.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^6.0.3"
  }
}
